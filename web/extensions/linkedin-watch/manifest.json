{
  "manifest_version": 3,
  "name": "career-ops LinkedIn watcher",
  "version": "0.5.3",
  "key": "",
  "description": "Reloads one saved LinkedIn jobs search at random intervals and sends new postings to your local career-ops app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "career-ops LinkedIn watcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "alarms",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/jobs/search*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
